{
  "version": 1,
  "verified": "2026-10-28",
  "about": "Dated platform changes, each with the Microsoft Learn page that states the date. EstateSnapshot matches these against facts in a snapshot and reports the match; it does not say what to do about it. A shared copy can be pointed at with --retirements or the ESTATESNAPSHOT_RETIREMENTS environment variable, so the AHC and EstateSnapshot read one file.",
  "entries": [
    {"id": "functions-dotnet8", "title": "Azure Functions: .NET 8 (LTS) end of support", "date": "2026-11-10",
     "source": "https://learn.microsoft.com/azure/azure-functions/supported-languages",
     "match": {"kind": "function-runtime", "stack": "dotnet", "major": "8"}},
    {"id": "functions-dotnet9", "title": "Azure Functions: .NET 9 (STS) end of support", "date": "2026-11-10",
     "source": "https://learn.microsoft.com/azure/azure-functions/migrate-version-3-version-4",
     "match": {"kind": "function-runtime", "stack": "dotnet", "major": "9"}},
    {"id": "aks-approuting-nginx", "title": "AKS application routing add-on: managed NGINX ingress, Microsoft support for security patches ends", "date": "2026-11", "precision": "month",
     "source": "https://learn.microsoft.com/azure/aks/app-routing",
     "match": {"kind": "aks-app-routing-nginx"}},
    {"id": "aks-kubenet", "title": "AKS kubenet networking retires", "date": "2028-03-31",
     "source": "https://learn.microsoft.com/azure/aks/configure-kubenet",
     "match": {"kind": "aks-network-plugin", "value": "kubenet"}},
    {"id": "aks-npm", "title": "AKS Azure Network Policy Manager on Linux nodes no longer supported", "date": "2028-09-30",
     "source": "https://learn.microsoft.com/azure/aks/use-network-policies",
     "match": {"kind": "aks-network-policy", "value": "azure"}},
    {"id": "nsg-flow-logs", "title": "Network security group flow logs retire", "date": "2027-09-30",
     "source": "https://learn.microsoft.com/azure/network-watcher/nsg-flow-logs-overview",
     "match": {"kind": "nsg-flow-log"}},
    {"id": "vm-d-dsv2", "title": "VM sizes retire: D, Ds, Dv2 and Dsv2 series", "date": "2028-05-01",
     "source": "https://learn.microsoft.com/azure/virtual-machines/sizes/lifecycle/retirements-and-capacity-restrictions",
     "match": {"kind": "vm-size", "pattern": "^standard_ds?\\d{1,2}(_v2)?(_promo)?$"}},
    {"id": "vm-av2-b1", "title": "VM sizes retire: Av2, Amv2 and B-series (v1)", "date": "2028-11-15",
     "source": "https://learn.microsoft.com/azure/virtual-machines/sizes/lifecycle/retirements-and-capacity-restrictions",
     "match": {"kind": "vm-size", "pattern": "^standard_(a\\d{1,2}m?_v2|b\\d{1,2}(ms|s|ls))$"}},
    {"id": "vm-dv3-ev3", "title": "VM sizes retire: Dv3, Dsv3, Ev3 and Esv3 series", "date": "2029-11-15",
     "source": "https://learn.microsoft.com/azure/virtual-machines/sizes/lifecycle/retirements-and-capacity-restrictions",
     "match": {"kind": "vm-size", "pattern": "^standard_[de]\\d{1,3}(-\\d{1,2})?s?_v3$"}},
    {"id": "vm-np-hc-hbv2", "title": "VM sizes retire: NP, HC and HBv2 series", "date": "2027-05-31",
     "source": "https://learn.microsoft.com/azure/virtual-machines/sizes/lifecycle/retirements-and-capacity-restrictions",
     "match": {"kind": "vm-size", "pattern": "^standard_(np\\d+s|hc44(-\\d+)?rs|hb120(-\\d+)?rs_v2)$"}},
    {"id": "vm-dcsv2", "title": "VM sizes retire: DCsv2 series", "date": "2026-06-30",
     "source": "https://learn.microsoft.com/azure/virtual-machines/sizes/lifecycle/retirement/dcsv2-series-retirement",
     "match": {"kind": "vm-size", "pattern": "^standard_dc\\d+s_v2$"}}
  ]
}
